config BR2_PACKAGE_WHISPERCPP
	bool "whispercpp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  whisper.cpp is a CPU-friendly C/C++ inference of OpenAI's
	  Whisper automatic speech recognition model, built on ggml.

	  Mutebox uses the whisper-cli binary offline to transcribe
	  saved commercial audio clips so it can identify the
	  commercial by name, in the background, off the audio
	  detection hot path.

	  https://github.com/ggml-org/whisper.cpp

comment "whispercpp needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
